# Shared
SMARTQUEUE_ENV=local
SMARTQUEUE_PUBLIC_URL=http://localhost:5173
SMARTQUEUE_BACKEND_URL=http://localhost:8080
SMARTQUEUE_AI_SERVICE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=smartqueue
POSTGRES_USER=smartqueue
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_ISSUER=smartqueue-local
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI service
AI_SERVICE_PORT=8000
AI_PROVIDER=baseline
